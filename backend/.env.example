NODE_ENV=development
PORT=5000

# Pooled URL used by the runtime (Prisma datasource url).
# Append Prisma pooling flags to the pooled connection string:
#   &pgbouncer=true
# Do NOT add connection_limit=1: with a single pooled connection the admin
# dashboard stats endpoint (Promise.all of 8 prisma queries) exceeds the
# default 10s pool timeout and fails with P2024. Without the limit Prisma
# opens a small pool to the pgbouncer endpoint and stats completes in ~5s.
# TLS: keep `sslmode=require`. Do NOT use `sslmode=no-verify`.
# Prisma is PINNED to the 6.x line (package.json: prisma & @prisma/client
# exactly 6.19.3). Do not bump to Prisma 7 without re-verifying TLS + pooling.
DATABASE_URL="postgresql://user:password@host-pooler.example.com/db?sslmode=require&pgbouncer=true"

# Direct URL used by migrations only (no -pooler segment, no pgbouncer flag).
# Same TLS rules as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host.example.com/db?sslmode=require"

# Exact frontend origin(s). Comma-separated list supported with cookie auth.
FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=admin_session
COOKIE_SECURE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ethio Afro Tour <info@ethioafrotours.com>"
# Email provider: smtp | resend. For Resend, set EMAIL_PROVIDER=resend,
# paste the key below, and set EMAIL_ENABLED=true.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
ADMIN_EMAIL=info@ethioafrotours.com
ADMIN_PASSWORD=
EMAIL_ENABLED=false

# Path root for storing uploaded image files.
UPLOAD_ROOT=.
PUBLIC_FILE_BASE_URL=
MAX_UPLOAD_MB=4

# Persistent media storage. Vercel automatically uses PostgreSQL database
# storage ("database"); local disk remains the development default.
# STORAGE_DRIVER=database
# STORAGE_DRIVER=local

# ---------------------------------------------------------------------------
# AI Travel Assistant (Phase 4). Placeholders only — real keys are provided
# through the Vercel project's environment settings, never committed.
# ---------------------------------------------------------------------------
# Master switch; when true the selected provider key MUST be set (boot check).
ASSISTANT_ENABLED=false
# Provider: openai | gemini
ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
ASSISTANT_MODEL=gpt-5-mini
GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-3.1-flash-lite
# Conversation caps
ASSISTANT_MAX_MESSAGES=30
ASSISTANT_MAX_SESSION_TOKENS=50000
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_MAX_HISTORY_MESSAGES=10
ASSISTANT_MAX_CONTEXT_CHARS=40000
ASSISTANT_MAX_DAILY_TOKENS=200000
# Streaming + transport
ASSISTANT_STREAM=true
ASSISTANT_STREAM_TIMEOUT_MS=45000
# Catalog context cache TTL (ms)
ASSISTANT_CONTEXT_TTL_MS=300000
# Dev/debug: /api/v1/assistant/spike probe (default false)
ASSISTANT_SPIKE_ROUTE=false
# Salt for HMAC-SHA256 hashing of client IPs (falls back to JWT_SECRET)
ASSISTANT_IP_HASH_SALT=
